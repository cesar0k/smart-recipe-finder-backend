# Secret key for signing JWT tokens.
SECRET_KEY=change_me_to_a_random_hex_string_at_least_32_chars

# Port on which the FastAPI application will listen for incoming requests.
APP_PORT=8001

# "development" or "production". In production /docs, /redoc and /openapi.json
# are hidden and TrustedHostMiddleware is enforced against ALLOWED_HOSTS.
ENVIRONMENT=development

# Host header allow-list, enforced in production only. Use the public API
# domain(s); "*" allows anything (dev default).
# Example: ALLOWED_HOSTS='["api.smartrecipefinder.xyz"]'
ALLOWED_HOSTS='["*"]'

# Per-IP rate limits (slowapi, backed by Redis). DEFAULT applies to every
# /api/v1 route; AUTH layers on top of that for login/register/password
# reset/email verification endpoints; SEARCH for the vector-search endpoint
# (expensive because it runs the embedding model).
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SEARCH=30/minute

# List of origins that should be allowed to make cross-origin requests.
# Example: BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'

# Hostname of the database service. When using Docker Compose, this should be the service name (e.g., postgres).
DB_HOST=postgres
# Root password for the database server, used during initial setup (e.g., by Docker Compose).
DB_ROOT_PASSWORD=root_password
# Name of the database to connect to.
DB_NAME=recipes_db
# Username for the application to connect to the database.
DB_USER=user
# Password for the application's database user.
DB_PASSWORD=password
# Internal port of the PostgreSQL database container.
DB_INTERNAL_PORT=5432
# External port mapped to the PostgreSQL database container (for host access).
DB_EXTERNAL_PORT=5433

# Hostname for the ChromaDB vector store service.
CHROMA_HOST=chroma
# Port for the ChromaDB vector store service.
CHROMA_PORT=8000
# Name of the collection within ChromaDB to store recipe embeddings.
CHROMA_COLLECTION_NAME=recipes

# Hugging Face API token for accessing models (e.g., for embeddings). Obtainable from hf.co/settings/tokens
HF_TOKEN=YOUR_HUGGING_FACE_TOKEN
# The name of the embedding model to use for generating vector embeddings from recipe text.
# This model is used by the VectorStore to create embeddings for semantic search.
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct

# Secret used by the object store for inter-node RPC; must be 64 hex characters.
# Generate one with `openssl rand -hex 32`.
GARAGE_RPC_SECRET=
# Access key for the S3 bucket. Must be at least 8 characters.
S3_ACCESS_KEY=s3-access-key
# Secret key for the S3 bucket.
S3_SECRET_KEY=s3-secret-key-please-change
# Bucket that the application uploads objects to.
S3_BUCKET_NAME=recipe-images

# Internal S3 API endpoint (used by the application inside the Docker network).
S3_ENDPOINT=http://s3:3900
# Public base URL for uploaded objects.
S3_PUBLIC_ENDPOINT=http://recipe-images.web.s3.localhost:3902
# S3 region the backend is configured with.
S3_REGION=us-east-1

# Google OAuth2 (optional — leave empty to disable Google login).
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM (optional — leave keys empty to disable LLM-powered tagging and search).
# Supported providers: fal, openai (any OpenAI-compatible /chat/completions API).
LLM_PROVIDER=fal
LLM_MODEL=google/gemini-3-flash-preview
# fal.ai key. Format: key_id:key_secret. Obtain from https://fal.ai/dashboard/keys
FAL_KEY=
# OpenAI-compatible API key and base URL.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Captcha — Cloudflare Turnstile (privacy-friendly, works in Safari).
# Register a site at https://dash.cloudflare.com → Turnstile to obtain keys.
# Leave CAPTCHA_SECRET_KEY empty or set CAPTCHA_ENABLED=false to disable.
CAPTCHA_SECRET_KEY=
CAPTCHA_ENABLED=true

# SMTP / Email (optional — leave SMTP_HOST empty to disable email sending)
# Example: smtp-relay.example.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@smartrecipefinder.com
SMTP_FROM_NAME=Smart Recipe Finder
# Set to false to globally disable all outbound email
EMAILS_ENABLED=true
# Base URL of the frontend — used in email links (verify email, reset password)
FRONTEND_URL=http://localhost:5173

# MCP server (optional). The MCP process only needs the public REST API URL.
# Inside Docker Compose the API is reachable at http://app:8000.
SRF_API_URL=http://localhost:8001
# Public frontend URL used to build recipe links in MCP responses.
SRF_WEB_URL=http://localhost:5173
# Defaults for `python -m app.mcp.server`.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8002
